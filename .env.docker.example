# Copy this file to .env.docker.local and replace both password examples.
# .env.docker.local is ignored by Git and must never contain production secrets.
LOCAL_POSTGRES_DB=emporium_local
LOCAL_POSTGRES_USER=emporium_local
LOCAL_POSTGRES_PASSWORD=replace-with-a-long-random-local-password
LOCAL_POSTGRES_PORT=55432

LOCAL_REDIS_PASSWORD=replace-with-a-different-long-random-local-password
LOCAL_REDIS_PORT=56379
