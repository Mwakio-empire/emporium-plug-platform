SECRET_KEY=replace-with-a-long-development-only-secret
ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=0
REDIS_URL=redis://127.0.0.1:6379/1
# Development/test escape hatch only. Production rejects this setting.
LOCAL_CACHE_ONLY=False
SITE_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
TRUST_PROXY_HEADERS=False
PICKUP_RESERVATION_WORKING_DAYS=2
# Approved client policy: eligible non-clothing products only.
RETURN_REQUEST_WINDOW_DAYS=7
# Obtain the controller's legal identity and approval before production launch.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_NOTICE_APPROVED=False
NOTIFICATION_PROVIDER=console
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
WHATSAPP_FALLBACK_ENABLED=False
WHATSAPP_API_URL=
WHATSAPP_BEARER_TOKEN=
# Keep inbound callbacks disabled until a dedicated two-way SMS number is configured.
INBOUND_SMS_ENABLED=False
INBOUND_SMS_WEBHOOK_TOKEN=
# Client-approved WhatsApp ordering number in E.164 form, e.g. +2547XXXXXXXX.
# Leave blank until the business confirms which number owns this channel.
WHATSAPP_ORDER_PHONE=+254116153335
SECURE_SSL_REDIRECT=False
# Start with a short HSTS duration after HTTPS is verified. Include-subdomains
# and preload are intentionally opt-in because they are difficult to reverse.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_AWS_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1

# Optional off-site pg_dump archive. Managed PostgreSQL PITR remains mandatory.
BACKUP_ENABLED=False
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=emporium-plug/database
BACKUP_S3_REGION=eu-west-1
BACKUP_S3_KMS_KEY_ID=
PG_DUMP_BINARY=pg_dump
BACKUP_COMMAND_TIMEOUT_SECONDS=1800

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://127.0.0.1:8000/payments/mpesa/callback/
# Sandbox certification requires an HTTPS, publicly reachable staging callback.
# Never place credentials, tokens, passkeys, OTPs or customer data in test reports.
